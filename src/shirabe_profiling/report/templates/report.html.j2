        {% if tables.outliers | length > 5 %}
        <div class="bar-more">
          <button type="button" class="button" data-limit-toggle="outlier-list" aria-expanded="false" aria-controls="outlier-list">
            {{ icon('chevron-down', 14) }}<span class="more-label">Show {{ (tables.outliers | length) - 5 }} more</span>
          </button>
        </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    {% if overview.sample_head %}
